# Copy this file to .env.local for local development and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local or real secrets.

# Public URL of the deployed site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# If empty on Vercel, the production *.vercel.app domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Cal.com booking page used by the inline embed, popup and fallback links.
# Query parameters (e.g. overlayCalendar=true) are forwarded to the embed.
NEXT_PUBLIC_CAL_BOOKING_URL=https://cal.com/revexconsultancy/20min?overlayCalendar=true

# Resend API key (server-only). Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form notifications (server-only).
# Defaults to the business email (revexconsultancy@gmail.com). Separate multiple addresses with commas.
CONTACT_EMAIL=revexconsultancy@gmail.com

# Optional: verified sender used by Resend (server-only).
# Until you verify a domain in Resend, leave empty to use onboarding@resend.dev,
# which can only deliver to the email address that owns the Resend account
# (so create the Resend account with revexconsultancy@gmail.com).
RESEND_FROM_EMAIL=

# Optional: LinkedIn profile URL shown in the footer, contact and about pages.
NEXT_PUBLIC_LINKEDIN_URL=

# Public business email shown on the site (footer, contact page, privacy policy).
# Defaults to revexconsultancy@gmail.com.
NEXT_PUBLIC_BUSINESS_EMAIL=revexconsultancy@gmail.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When set, analytics only loads after a visitor accepts the consent banner.
NEXT_PUBLIC_GA_ID=
